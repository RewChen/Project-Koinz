generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum PaymentMethod {
  PROMPTPAY
  WALLET
}
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REFUNDED
  REFUND_NEEDED
}
enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADMIN_ADJUST
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  password_hash  String
  role           UserRole            @default(USER)
  wallet_balance Decimal             @default(0) @db.Decimal(12, 2)
  created_at     DateTime            @default(now())
  orders         Order[]
  transactions   WalletTransaction[]
}

model Game {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  category   String
  image_url  String?
  form_schema Json
  is_active  Boolean   @default(true)
  packages   Package[]
  orders     Order[]
  created_at DateTime  @default(now())
}

model Package {
  id             String   @id @default(cuid())
  game_id        String
  supplier_sku   String
  name           String
  cost_price     Decimal  @db.Decimal(12, 2)
  selling_price  Decimal  @db.Decimal(12, 2)
  is_active      Boolean  @default(true)
  game           Game     @relation(fields: [game_id], references: [id])
  orders         Order[]
  @@index([game_id, is_active])
}

model Order {
  id              String        @id @default(cuid())
  order_number    String        @unique
  user_id         String?
  game_id         String
  package_id      String
  player_inputs   Json
  player_nickname String?
  amount          Decimal       @db.Decimal(12, 2)
  payment_method  PaymentMethod
  status          OrderStatus   @default(PENDING)
  supplier_ref    String?
  idempotency_key String        @unique
  expires_at      DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  user            User?         @relation(fields: [user_id], references: [id])
  game            Game          @relation(fields: [game_id], references: [id])
  package         Package       @relation(fields: [package_id], references: [id])
  transactions    WalletTransaction[]
  @@index([status, created_at])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  user_id        String
  order_id       String?
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(12, 2)
  balance_before Decimal               @db.Decimal(12, 2)
  balance_after  Decimal               @db.Decimal(12, 2)
  created_at     DateTime              @default(now())
  user           User                  @relation(fields: [user_id], references: [id])
  order          Order?                @relation(fields: [order_id], references: [id])
  @@index([user_id, created_at])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String
  target_type String
  target_id   String
  action      String
  metadata    Json
  created_at  DateTime @default(now())
  @@index([target_type, target_id, created_at])
}
