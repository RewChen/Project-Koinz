# ตัวแปรสำหรับ service "koinz" บน Railway
# วิธีใช้: Railway → service koinz → Variables → Raw Editor → วางทั้งไฟล์นี้ แล้วแก้ค่าที่มี <...>
# ไม่ต้องตั้ง PORT (Railway ใส่ให้เอง) และไม่ต้องตั้ง KOINZ_DATA_DIR / POSTGRES_PASSWORD (ใช้เฉพาะ Docker Compose)

NODE_ENV=production
# ยาวอย่างน้อย 12 ตัว ห้ามใช้ค่าตัวอย่าง ไม่งั้นเซิร์ฟเวอร์จะไม่ยอมเริ่ม
ADMIN_PASSWORD=<รหัสผ่านหลังบ้านที่ยาว 12 ตัวขึ้นไป>

# อ้างอิงฐานข้อมูล Postgres ใน project เดียวกัน (ต่อกันผ่านเครือข่ายภายในของ Railway)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway มี proxy ด้านหน้า 1 ชั้น → ให้ rate limit เห็น IP จริงของลูกค้า
TRUST_PROXY=1

SHOP_NAME=Koinz
PROMPTPAY_ID=<เบอร์โทร 10 หลัก หรือเลขบัตรประชาชน 13 หลักที่ผูก PromptPay>
PROMPTPAY_NAME=<ชื่อบัญชีที่ลูกค้าเห็นตอนโอน>
ORDER_TTL_MINUTES=15

# ข้อมูลร้าน (หน้าเกี่ยวกับร้าน / ติดต่อ / นโยบายคืนเงิน) — เว้นว่าง = ซ่อนแถวนั้น · ลิงก์ต้องเป็น https://
# LINE: SHOP_LINE_ID แสดงเป็นข้อความ, SHOP_LINE_URL คือลิงก์เพิ่มเพื่อน (ID ส่วนตัวใช้ https://line.me/ti/p/~<ID>)
SHOP_LINE_ID=deworldr
SHOP_LINE_URL=https://line.me/ti/p/~deworldr
SHOP_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61596943354373
# ชื่อเพจที่แสดง (เว้นว่าง = "เพจ Facebook")
SHOP_FACEBOOK_NAME=
# เวลาตอบแชท
SHOP_HOURS=09:00–22:00 น.
# ชื่อผู้ประกอบการ / บริษัท และเลขทะเบียนพาณิชย์อิเล็กทรอนิกส์ (ถ้ามี)
SHOP_LEGAL_NAME=
SHOP_DBD_ID=
# เติมโดยประมาณกี่นาที (ในเวลาทำการ) / คืนเงินภายในกี่ชั่วโมง / โอนแล้วไม่ขยับเกินกี่ชั่วโมงให้ทักร้าน
FULFILL_TARGET_MINUTES=15
REFUND_HOURS=24
STUCK_ORDER_HOURS=1

# เปิดเมื่อพร้อม (เว้นว่าง = ปิด)
PAYMENT_WEBHOOK_SECRET=
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
FULFILL_ATTEMPTS=3
FULFILL_RETRY_BASE_SECONDS=3
LOOKUP_API_URL=
LOOKUP_API_KEY=
LOOKUP_MOCK=0
ADMIN_ALERT_WEBHOOK=

# ตั้งเฉพาะถ้ายังใช้หน้าร้านบน GitHub Pages เรียก API บน Railway (เช่น https://rewchen.github.io)
FRONTEND_ORIGIN=

# ระบบสมาชิก — สุ่มยาว ≥32 ตัว ห้ามซ้ำกับ staging (ไม่ตั้ง = เว็บไม่ยอม start)
# สุ่มได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<สุ่มยาว 32 ตัวขึ้นไป>
TERMS_VERSION=2026-11
LINE_LOGIN_ENABLED=0

# อีเมลลืมรหัสผ่าน — เว้นว่าง = ปิด "ลืมรหัสผ่าน?" (ลูกค้าติดต่อร้านทาง LINE แทน)
# เปิดเมื่อพร้อม: MAIL_PROVIDER=resend + RESEND_API_KEY + MAIL_FROM (โดเมนต้องยืนยันใน Resend ก่อน)
# ห้ามตั้ง MAIL_PROVIDER=log / MAIL_LOG_LINKS=1 บนเว็บจริง
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
MAIL_LOG_LINKS=0
# ตั้งเมื่อใช้โดเมนของร้านเอง (Custom Domain) เช่น https://koinz.example.com — เว้นว่าง = ใช้โดเมน Railway
PUBLIC_URL=

# แถบเหลืองบนสุด — production เว้นว่างไว้ / staging ตั้งเป็น: เว็บทดสอบ — ห้ามโอนเงินจริง
SITE_BANNER=
