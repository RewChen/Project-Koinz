{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "railway.json",
      "package.json",
      "package-lock.json",
      "server.js",
      "src/**",
      "db/**",
      "docker/**",
      "public/**",
      "docs/games.v2.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/config",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "drainingSeconds": 10,
    "sleepApplication": false
  }
}
